{
  "name": "mcp-code-mode-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmark: classic MCP tool calls vs Code Mode (Claude API programmatic tool calling, tool search, Claude Code Code Mode) on the same mock MCP server.",
  "license": "MIT",
  "author": "José Antonio Garrido (https://github.com/yeyo11)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeyo11/mcp-code-mode-bench.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && tsx --test test/*.test.ts",
    "fixtures": "tsx server/src/write-fixtures.ts",
    "server": "node dist/server/src/index.js",
    "prebench": "tsc",
    "bench": "node dist/bench/src/cli.js",
    "prereport": "tsc",
    "report": "node dist/bench/src/report.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
